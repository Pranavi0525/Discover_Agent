# Needed only when using the live Tavily adapter.
TAVILY_API_KEY=

# Hosted planner model: Google AI Studio free-tier Gemini Flash.
# Use the currently supported Flash model name for your account/region.
GOOGLE_API_KEY=
GEMINI_MODEL=

# Optional append-only audit ledger location.
DISCOVERY_LEDGER_PATH=data/discovery-runs.jsonl

# Shopify MCP stdio configuration. Values are local only.
SHOPIFY_MCP_COMMAND=npx
SHOPIFY_MCP_ARGS=-y shopify-mcp
SHOPIFY_SEARCH_TOOL=get-products
SHOPIFY_PRODUCT_TOOL=get-product-by-id
SHOPIFY_SHOP_DOMAIN=
# The catalog server requires client credentials or an access token for private stores.
# Use SHOPIFY_ACCESS_TOKEN or SHOPIFY_CLIENT_ID/SHOPIFY_CLIENT_SECRET locally.


# Phase 2 input guard (rules always on when enabled; classifier optional)
# GUARD_ENABLED=1
# GUARD_CLASSIFIER=none   # none | promptguard-22m | promptguard-86m | deberta | org/model
# GUARD_MAX_CHARS=1000
# GUARD_BLOCK_THRESHOLD=0.90
# GUARD_REVIEW_THRESHOLD=0.50
# GUARD_FAIL_CLOSED=0

# Phase 2 idempotency and rate limiting (0 disables each)
# DEDUP_WINDOW_SECONDS=120
# RATE_LIMIT_MAX_RUNS=5
# RATE_LIMIT_WINDOW_SECONDS=60
